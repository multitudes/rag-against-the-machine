[flake8]
# Exclude virtual environment, git, and cache directories from linting
exclude =
    .venv,
    .git,
    __pycache__,
    .mypy_cache,
    .pytest_cache,
    build,
    dist,
    llm_sdk,
    data,
    .vscode,
    docs,
    scripts,

# Enforce 80 character line length limit per 42 standards
max-line-length = 80